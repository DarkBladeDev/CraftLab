# ==============================================================================
# CraftLab Environment Configuration Template
# Copy this file to .env to configure local settings:
#   cp .env.example .env
# ==============================================================================

# --- Authentication & Access Control ---
# Set to 'true' to enforce RBAC and session checks across the CraftLab platform
CRAFTLAB_AUTH_ENABLED=false

# Break-glass emergency root secret key (replace with a strong random secret)
# Usage: Authorization: Bearer <your_secret_key>
CRAFTLAB_ROOT_KEY=change_me_to_a_secure_root_token

# --- Backend Application Service ---
CRAFTLAB_HOST=127.0.0.1
CRAFTLAB_PORT=8000

# --- Supervisor Daemon (craftctld) ---
CRAFTLAB_CTL_HOST=127.0.0.1
CRAFTLAB_CTL_PORT=8443

# --- Database & Storage (Optional Overrides) ---
# CRAFTLAB_DATABASE_URL=sqlite+aiosqlite:///data/mcp.db
# CRAFTLAB_HOME=.
